{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "Contact Book API",
    "description": "Це API для керування контактами користувача. Ви можете створювати, оновлювати, видаляти та переглядати контакти.\n",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3001"
    },
    {
      "url": "https://nodejs-hw-mongodb-7-gti2.onrender.com"
    }
  ],
  "tags": [
    {
      "name": "Contacts",
      "description": "Операції для роботи з контактами"
    },
    {
      "name": "Auth",
      "description": "Авторизація та логін користувачів"
    }
  ],
  "paths": {
    "/contacts": {
      "get": {
        "get": {
          "tags": [
            "Contacts"
          ],
          "summary": "Отримати всі контакти користувача",
          "operationId": "getAllContacts",
          "description": "Отримати список всіх контактів, з optional query параметрами фільтрації",
          "security": [
            {
              "bearerAuth": []
            }
          ],
          "parameters": [
            {
              "name": "page",
              "in": "query",
              "required": false,
              "schema": {
                "type": "integer",
                "example": 1
              }
            },
            {
              "name": "limit",
              "in": "query",
              "required": false,
              "schema": {
                "type": "integer",
                "example": 20
              }
            },
            {
              "name": "favorite",
              "in": "query",
              "required": false,
              "schema": {
                "type": "boolean",
                "example": true
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Успішно отримано список контактів",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Contact"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "post": {
          "tags": [
            "Contacts"
          ],
          "summary": "Створити новий контакт",
          "operationId": "createContact",
          "description": "Додає новий контакт до бази даних",
          "security": [
            {
              "bearerAuth": []
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NewContact"
                }
              }
            }
          },
          "responses": {
            "201": {
              "description": "Контакт створено",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Contact"
                  }
                }
              }
            },
            "400": {
              "description": "Некоректні дані"
            }
          }
        }
      }
    },
    "/contacts/{contactId}": {
      "get": {
        "get": {
          "tags": [
            "Contacts"
          ],
          "summary": "Отримати контакт за Id",
          "operationId": "getContactById",
          "description": "Отримати інформацію про конкретного контакта за його унікальним ідентифікатором",
          "security": [
            {
              "bearerAuth": []
            }
          ],
          "parameters": [
            {
              "name": "contactId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Контакт знайдено",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Contact"
                  }
                }
              }
            },
            "404": {
              "description": "Контакт не знайдено"
            }
          }
        }
      },
      "patch": {
        "patch": {
          "tags": [
            "Contacts"
          ],
          "summary": "Оновити контакт за Id",
          "operationId": "updateContactById",
          "description": "Оновлює дані певного контакта за його ID",
          "security": [
            {
              "bearerAuth": []
            }
          ],
          "parameters": [
            {
              "name": "contactId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string"
              }
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateContact"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Контакт оновлено",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Contact"
                  }
                }
              }
            },
            "404": {
              "description": "Контакт не знайдено"
            }
          }
        }
      },
      "delete": {
        "delete": {
          "tags": [
            "Contacts"
          ],
          "summary": "Видалити контакт за Id",
          "operationId": "deleteContactById",
          "description": "Видаляє контакт із бази даних",
          "security": [
            {
              "bearerAuth": []
            }
          ],
          "parameters": [
            {
              "name": "contactId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string"
              }
            }
          ],
          "responses": {
            "204": {
              "description": "Контакт успішно видалено (без тіла відповіді)"
            },
            "404": {
              "description": "Контакт не знайдено"
            }
          }
        }
      }
    },
    "/auth/google": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Увійти через Google",
        "description": "Ініціалізує логін через Google OAuth 2.0",
        "responses": {
          "302": {
            "description": "Редірект на Google OAuth"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Contact": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "6435fc7c11f9c8a6e4e1e994"
          },
          "name": {
            "type": "string",
            "example": "Viktor Baratej"
          },
          "email": {
            "type": "string",
            "example": "Viktor1baratejj@gmail.com"
          },
          "phone": {
            "type": "string",
            "example": 380660728708
          },
          "favorite": {
            "type": "boolean",
            "example": false
          },
          "photo": {
            "type": "string",
            "example": "https://res.cloudinary.com/demo/image/upload/sample.jpg"
          }
        },
        "required": [
          "name",
          "email",
          "phone"
        ]
      },
      "NewContact": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Artem Baratej"
          },
          "email": {
            "type": "string",
            "example": "artemb@example.com"
          },
          "phone": {
            "type": "string",
            "example": 380991234567
          },
          "favorite": {
            "type": "boolean",
            "example": false
          }
        },
        "required": [
          "name",
          "email",
          "phone"
        ]
      },
      "UpdateContact": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "favorite": {
            "type": "boolean"
          }
        }
      }
    }
  }
}