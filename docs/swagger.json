{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "Contact Book API",
    "description": "Це API для керування контактами користувача. Ви можете створювати, оновлювати, видаляти та переглядати контакти.\n",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3001"
    },
    {
      "url": "https://nodejs-hw-mongodb-7-gti2.onrender.com"
    }
  ],
  "tags": [
    {
      "name": "Contacts",
      "description": "Операції для роботи з контактами"
    }
  ],
  "paths": {
    "/contacts": {
      "get": {
        "tags": [
          "Contacts"
        ],
        "summary": "Отримати всі контакти користувача",
        "operationId": "getAllContacts",
        "description": "Отримати список всіх контактів, з optional query параметрами фільтрації, пагінації та сортування.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "example": 1
            },
            "description": "Номер сторінки для пагінації. За замовчуванням 1."
          },
          {
            "name": "perPage",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "example": 10
            },
            "description": "Кількість елементів на сторінці. За замовчуванням 10."
          },
          {
            "name": "sortBy",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "example": "name"
            },
            "description": "Параметр для сортування за полем. За замовчуванням - name."
          },
          {
            "name": "sortOrder",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "example": "asc"
            },
            "description": "Параметр для сортування у порядку зростання або спадання."
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "example": "work"
            },
            "description": "Фільтрація за типом контакту. Можливі значення: work, home, personal."
          },
          {
            "name": "isFavourite",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "example": true
            },
            "description": "Фільтрація за ознакою улюбленості контакту."
          }
        ],
        "responses": {
          "200": {
            "description": "Успішно отримано список контактів",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully fetched contacts"
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "data",
                        "page",
                        "perPage",
                        "totalItems",
                        "totalPages",
                        "hasNextPage",
                        "hasPreviousPage"
                      ],
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Contact"
                          }
                        },
                        "page": {
                          "type": "integer",
                          "example": 1
                        },
                        "perPage": {
                          "type": "integer",
                          "example": 10
                        },
                        "totalItems": {
                          "type": "integer",
                          "example": 100
                        },
                        "totalPages": {
                          "type": "integer",
                          "example": 10
                        },
                        "hasNextPage": {
                          "type": "boolean",
                          "example": true
                        },
                        "hasPreviousPage": {
                          "type": "boolean",
                          "example": false
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      },
      "post": {
        "tags": [
          "Contacts"
        ],
        "summary": "Створити новий контакт",
        "operationId": "createContact",
        "description": "Додає новий контакт до бази даних",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "phoneNumber",
                  "contactType"
                ],
                "properties": {
                  "name": {
                    "description": "Ім'я контакту",
                    "type": "string",
                    "example": "John Doe"
                  },
                  "email": {
                    "description": "Електронна пошта контакту",
                    "type": "string",
                    "example": "johndoe@example.com"
                  },
                  "phoneNumber": {
                    "description": "Номер телефону контакту",
                    "type": "string",
                    "example": "+380991234567"
                  },
                  "isFavourite": {
                    "description": "Чи є цей контакт улюбленим",
                    "type": "boolean",
                    "example": true
                  },
                  "contactType": {
                    "description": "Тип контакту (work, home, personal)",
                    "type": "string",
                    "enum": [
                      "work",
                      "home",
                      "personal"
                    ],
                    "example": "personal"
                  },
                  "photo": {
                    "description": "Фото контакту",
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Контакт створено",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 201
                    },
                    "message": {
                      "type": "string",
                      "example": "Контакт успішно створено"
                    },
                    "data": {
                      "type": "object",
                      "$ref": "#/components/schemas/Contact"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    },
    "/contacts/{contactId}": {
      "get": {
        "tags": [
          "Contacts"
        ],
        "summary": "Отримати контакт за ID",
        "operationId": "getContactById",
        "description": "Отримує інформацію про контакт за його унікальним ID",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "contactId",
            "in": "path",
            "required": true,
            "description": "Унікальний ідентифікатор контакту",
            "schema": {
              "type": "string",
              "example": "60d6b3e32f9b8c001c2bb8d7"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Контакт знайдено",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully found contact with id 60d6b3e32f9b8c001c2bb8d7!"
                    },
                    "data": {
                      "type": "object",
                      "$ref": "#/components/schemas/Contact"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      },
      "patch": {
        "tags": [
          "Contacts"
        ],
        "summary": "Оновити контакт за Id",
        "operationId": "updateContact",
        "description": "Оновлює контакт за його унікальним ідентифікатором",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "contactId",
            "in": "path",
            "required": true,
            "description": "Унікальний ідентифікатор контакту",
            "schema": {
              "type": "string",
              "example": "60d6b3e32f9b8c001c2bb8d7"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "description": "Ім'я контакту",
                    "type": "string",
                    "example": "Artem Baratej"
                  },
                  "phoneNumber": {
                    "description": "Номер телефону контакту",
                    "type": "string",
                    "example": "+38011111111"
                  },
                  "email": {
                    "description": "Електронна пошта контакту",
                    "type": "string",
                    "example": "Tema1814@gmail.com"
                  },
                  "isFavourite": {
                    "description": "Чи є цей контакт улюбленим",
                    "type": "boolean",
                    "example": true
                  },
                  "contactType": {
                    "description": "Тип контакту (work, home, personal)",
                    "type": "string",
                    "enum": [
                      "work",
                      "home",
                      "personal"
                    ],
                    "example": "personal"
                  },
                  "photo": {
                    "description": "Аватар контакту",
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Контакт успішно оновлено",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Контакт успішно оновлено"
                    },
                    "data": {
                      "type": "object",
                      "$ref": "#/components/schemas/Contact"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      },
      "delete": {
        "tags": [
          "Contacts"
        ],
        "summary": "Видалити контакт за ID",
        "operationId": "deleteContactById",
        "description": "Видаляє контакт із бази даних за його ID",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "contactId",
            "in": "path",
            "required": true,
            "description": "Унікальний ідентифікатор контакту",
            "schema": {
              "type": "string",
              "example": "12345"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Контакт успішно видалено (без тіла відповіді)"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Contact": {
        "type": "object",
        "required": [
          "_id",
          "name",
          "phoneNumber",
          "contactType",
          "userId"
        ],
        "properties": {
          "_id": {
            "description": "Унікальний ID контакту",
            "type": "string",
            "example": "12345"
          },
          "userId": {
            "description": "Ідентифікатор користувача, до якого належить цей контакт",
            "type": "string",
            "example": "60d6b3e32f9b8c001c2bb8d7"
          },
          "name": {
            "description": "Повне ім'я контакту",
            "type": "string",
            "example": "John Doe"
          },
          "email": {
            "description": "Адреса електронної пошти контакту",
            "type": "string",
            "example": "johndoe@example.com"
          },
          "phoneNumber": {
            "description": "Номер телефону контакту",
            "type": "string",
            "example": "+380991234567"
          },
          "isFavourite": {
            "description": "Чи позначено контакт як улюблений",
            "type": "boolean",
            "example": false
          },
          "contactType": {
            "description": "Тип контакту (work, home, personal)",
            "type": "string",
            "enum": [
              "work",
              "home",
              "personal"
            ],
            "example": "personal"
          },
          "photo": {
            "description": "URL фотографії контакту",
            "type": "string",
            "example": "https://example.com/photo.jpg"
          }
        }
      }
    },
    "responses": {
      "400": {
        "description": "Помилка \"Невірний запит\"",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "status",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer",
                  "example": 400,
                  "description": "HTTP статус код 400, що вказує на некоректний запит клієнта."
                },
                "message": {
                  "type": "string",
                  "example": "Невірні дані у запиті.",
                  "description": "Повідомлення про помилку, яке вказує на проблеми у запиті."
                }
              }
            }
          }
        }
      },
      "401": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "data": {
                  "properties": {
                    "message": {
                      "description": "Детальніше повідомлення про причину помилки.",
                      "example": "Токен доступу протермінований",
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ],
                  "type": "object"
                },
                "message": {
                  "description": "Код або тип помилки авторизації.",
                  "example": "UnauthorizedError",
                  "type": "string"
                },
                "status": {
                  "description": "HTTP статус код 401, що означає відсутність авторизації.",
                  "example": 401,
                  "type": "integer"
                }
              },
              "required": [
                "status",
                "message",
                "data"
              ],
              "type": "object"
            }
          }
        },
        "description": "Помилка \"Несанкціонований доступ\""
      },
      "404": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "message": {
                  "description": "Повідомлення про те, що запитуваний ресурс не існує.",
                  "example": "Контакт не знайдено",
                  "type": "string"
                },
                "status": {
                  "description": "HTTP статус код 404, що означає, що ресурс не знайдено.",
                  "example": 404,
                  "type": "integer"
                }
              },
              "required": [
                "status",
                "message"
              ],
              "type": "object"
            }
          }
        },
        "description": "Помилка \"Не знайдено\""
      },
      "500": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "message": {
                  "description": "Загальне повідомлення про помилку, яке вказує на проблеми на стороні сервера.",
                  "example": "Внутрішня помилка сервера. Сталася непередбачувана помилка на стороні сервера.",
                  "type": "string"
                },
                "status": {
                  "description": "HTTP статус код 500, що вказує на внутрішню помилку сервера.",
                  "example": 500,
                  "type": "integer"
                }
              },
              "required": [
                "status",
                "message"
              ],
              "type": "object"
            }
          }
        },
        "description": "Помилка \"Внутрішня помилка сервера\""
      }
    }
  }
}